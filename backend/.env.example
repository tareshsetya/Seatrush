PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
DATABASE_URL=postgresql://seatrush:seatrush_local_only@localhost:5432/seatrush_db
REDIS_URL=redis://localhost:6379
HOLD_DURATION_SECONDS=600
# This only simulates checkout; no real payments or Stripe PaymentIntents.
DEMO_CHECKOUT_ENABLED=true
# Local-only destructive diagnostics. Server refuses to enable in NODE_ENV=production.
ENABLE_DEMO_ADMIN_TOOLS=true
# Stripe integration is not complete. Do not add real keys until checkout is implemented.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Generate a strong 32+ character random secret for real deployments. DEV ONLY value below.
JWT_SECRET=local-development-only-replace-with-random-secret-please
# For frontend/backend on separate cross-site domains, production needs HTTPS + SameSite=None.
# AUTH_COOKIE_SAMESITE=none
# Ticketmaster Discovery API key (server-side only): https://developer.ticketmaster.com/
TICKETMASTER_API_KEY=
# TMDB API v3 key or v4 bearer token (server-side only): https://developer.themoviedb.org/
TMDB_API_KEY=
